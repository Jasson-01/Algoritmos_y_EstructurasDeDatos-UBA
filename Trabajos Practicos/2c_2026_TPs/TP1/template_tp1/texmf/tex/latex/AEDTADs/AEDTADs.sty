\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{AEDTADs}[2025/08/14 Macros de especificacion de TADs para AED]

\RequirePackage{AEDLogica}  % En realidad ya viene adentro del de especificacion pero como vamos a usar estas cosas por separado creo que tiene sentido pedirlo igual
\RequirePackage{AEDEspecificacion}
\RequirePackage{AEDUtil}    % RequireMathMode
\RequirePackage{changepage} % Para indentar, adjustwidth depende de esto
\RequirePackage{xstring}

% \obs{Nombre}{Tipo}
\newcommand{\obs}[2]{\noindent\texttt{obs} #1 $: #2$}

%\igualdad{Tipo}{Cuerpo}
\newcommand{\igualdad}[2]{
	\StrChar{#1}{1}[\inicialTipo]

	\begin{proc}{igualdad}{\In \inicialTipo_1: #1, \In \inicialTipo_2: #1}{\bool}
		\aseguraCorto{res = \textsf{true} \sii #2}
	\end{proc}
}

%\igualdad{TipoParamétrico}{Parámetro}{Cuerpo}
\newcommand{\igualdadParam}[3]{
	\StrChar{#1}{1}[\inicialTipo]

	\begin{proc}{igualdad}{\In \inicialTipo_1: \TipoParam{#1}{#2}, \In \inicialTipo_2: \TipoParam{#1}{#2}}{\bool}
		\asegura{res = \textsf{true} \sii #3}
	\end{proc}
}
% \begin{tad}{Nombre}
% Si es un tad parametrico, meter eso directo en el nombre
\newenvironment{tad}[1]{
    \noindent\texttt{TAD} #1 \{
    \smallskip
    \begin{adjustwidth}{+1.5em}{}
}{
    \end{adjustwidth}
    \}
}


% Algunos TADs comunes
\newcommand{\Secuencia}[1]{\RequireMathMode{Secuencia}{\TipoParam{Secuencia}{#1}}}
\newcommand{\Diccionario}[2]{\RequireMathMode{Diccionario}{\TipoParamDos{Diccionario}{#1}{#2}}}
\newcommand{\Conjunto}[1]{\RequireMathMode{Conjunto}{\TipoParam{Conjunto}{#1}}}

